    "version": "0.2.0",
    "configurations": [
      {
        "name": "Flutter: Run all Tests",
        "type": "dart",
        "request": "launch",
        "program": "./test/"
      },
        
        {
        "name": "Run.dev",
        "request": "launch",
        "type": "dart",
        "program": "lib/main_prod.dart",
        "args": ["--flavor", "development", "--target", "lib/main_prod.dart" ]
      },
      {
        "name": "Run.Prod",
        "request": "launch",
        "type": "dart",
        "flutterMode": "release",
        "program": "lib/main_prod.dart",
        "args": ["--flavor", "production", "--target", "lib/main_prod.dart" ]
      }
       
    ]
}